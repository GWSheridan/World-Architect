{
  "format": 3,
  "preset": "worldsunwritten_examples:modpack_mixed",
  "title": "Mixed-dimension authoring pack",
  "description": "Personal Overworld islands, a shared Nether island and a native End, with editable protection defaults.",
  "author": "GWSHERIDAN",
  "release": "1.8.0",
  "lock": "partial",
  "options": {
    "seed": 18,
    "generate_structures": true,
    "bonus_chest": false
  },
  "required_mods": [
    "minecraft",
    "worldsunwritten"
  ],
  "allow_structure_library": false,
  "pack": {
    "version": 1,
    "defaults": {
      "version": 1,
      "protection": {
        "breaking": true,
        "placement": true,
        "containers": true,
        "shared": true
      }
    },
    "editable": [
      "protection"
    ]
  }
}
